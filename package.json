{
  "name": "mc-project-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --experimental-strip-types --experimental-loader ./ui/test-loader.mjs --test ui/__tests__/*.test.ts ui/__tests__/*.test.tsx",
    "test": "npm run test:ui"
