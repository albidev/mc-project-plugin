{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx"],
  "exclude": ["ui/__tests__/**"]
}
